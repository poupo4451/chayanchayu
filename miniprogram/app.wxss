/**app.wxss**/
page {
  --primary-pink: #FF2D78;
  --primary-purple: #7C3AED;
  --primary-gold: #FFB800;
  --bg-deep: #0E0B16;
  --bg-card: #1A1625;
  --text-main: #FFFFFF;
  --text-sub: #A5A0B8;
  --success: #22C55E;
  --danger: #EF4444;
  --info: #60A5FA;

  background-color: var(--bg-deep);
  font-family: 'PingFang SC', -apple-system, BlinkMacSystemFont, 'Helvetica Neue',
    Helvetica, 'Hiragino Sans GB', 'Microsoft YaHei UI', 'Microsoft YaHei', Arial, sans-serif;
  font-size: 14px;
  color: var(--text-main);
  box-sizing: border-box;
}

/* 通用容器 */
.container {
  min-height: 100vh;
  padding: 30rpx;
  box-sizing: border-box;
  background-color: var(--bg-deep);
}

.page {
  min-height: 100vh;
  padding: 60rpx 40rpx;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  background-color: var(--bg-deep);
  color: var(--text-main);
}

.page-title {
  font-size: 22px;
  font-weight: 700;
  margin-bottom: 16rpx;
}

.page-desc {
  font-size: 14px;
  color: var(--text-sub);
  line-height: 1.6;
}

/* 卡片样式：玻璃拟态 */
.card {
  background: rgba(26, 22, 37, 0.7);
  border: 1px solid rgba(255, 255, 255, 0.08);
  border-radius: 24rpx;
  padding: 30rpx;
  margin-bottom: 20rpx;
  backdrop-filter: blur(20rpx);
}

/* 渐变按钮 */
.btn-gradient {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 88rpx;
  border-radius: 44rpx;
  font-size: 16px;
  font-weight: 600;
  color: var(--text-main);
  background: linear-gradient(135deg, var(--primary-pink) 0%, var(--primary-purple) 100%);
}

.text-sub {
  color: var(--text-sub);
}

.flex-row {
  display: flex;
  flex-direction: row;
}

.flex-column {
  display: flex;
  flex-direction: column;
}

.justify-between {
  justify-content: space-between;
}

.justify-center {
  justify-content: center;
}

.align-center {
  align-items: center;
}

.text-center {
  text-align: center;
}
