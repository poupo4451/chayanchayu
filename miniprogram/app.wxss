/**app.wxss**/
page {
  --primary: #00B865;
  --primary-dark: #009A55;
  --primary-light: rgba(0, 184, 101, 0.12);
  --bg-page: #EDEDED;
  --bg-card: #FFFFFF;
  --text-main: #1A1A1A;
  --text-sub: #999999;
  --text-hint: #B2B2B2;
  --border: rgba(0, 0, 0, 0.06);
  --success: #00B865;
  --danger: #E74C3C;
  --info: #3498DB;

  background-color: var(--bg-page);
  font-family: 'PingFang SC', -apple-system, BlinkMacSystemFont, 'Helvetica Neue',
    Helvetica, 'Hiragino Sans GB', 'Microsoft YaHei UI', 'Microsoft YaHei', Arial, sans-serif;
  font-size: 14px;
  color: var(--text-main);
  box-sizing: border-box;
}

/* 通用容器 */
.container {
  min-height: 100vh;
  padding: 30rpx;
  box-sizing: border-box;
  background-color: var(--bg-page);
}

.page {
  min-height: 100vh;
  padding: 60rpx 40rpx;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  background-color: var(--bg-page);
  color: var(--text-main);
}

.page-title {
  font-size: 22px;
  font-weight: 700;
  margin-bottom: 16rpx;
  color: var(--text-main);
}

.page-desc {
  font-size: 14px;
  color: var(--text-sub);
  line-height: 1.6;
}

/* 卡片样式：白底微阴影 */
.card {
  background: var(--bg-card);
  border-radius: 24rpx;
  padding: 30rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 16rpx rgba(0, 0, 0, 0.04);
}

/* 渐变按钮 */
.btn-gradient {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 88rpx;
  border-radius: 44rpx;
  font-size: 16px;
  font-weight: 600;
  color: #FFFFFF;
  background: linear-gradient(135deg, var(--primary) 0%, var(--primary-dark) 100%);
}

.text-sub {
  color: var(--text-sub);
}

.flex-row {
  display: flex;
  flex-direction: row;
}

.flex-column {
  display: flex;
  flex-direction: column;
}

.justify-between {
  justify-content: space-between;
}

.justify-center {
  justify-content: center;
}

.align-center {
  align-items: center;
}

.text-center {
  text-align: center;
}
