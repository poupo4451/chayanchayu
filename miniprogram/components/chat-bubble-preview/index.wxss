.bubble-row {
  display: flex;
  align-items: flex-start;
  margin-bottom: 24rpx;
}

.bubble-row-right {
  flex-direction: row-reverse;
}

.avatar {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #fff;
  font-size: 14px;
  font-weight: 600;
  flex-shrink: 0;
  background: linear-gradient(135deg, #7C3AED 0%, #FF2D78 100%);
}

.avatar-right {
  background: linear-gradient(135deg, #FFB800 0%, #FF2D78 100%);
  margin-left: 16rpx;
}

.avatar-left {
  margin-right: 16rpx;
}

.bubble {
  max-width: 460rpx;
  padding: 16rpx 24rpx;
  border-radius: 20rpx;
  background: rgba(255,255,255,0.08);
}

.bubble-right {
  background: linear-gradient(135deg, rgba(255,45,120,0.4) 0%, rgba(124,58,237,0.4) 100%);
}

.bubble-name {
  display: block;
  font-size: 11px;
  color: var(--text-sub);
  margin-bottom: 6rpx;
}

.bubble-text {
  font-size: 14px;
  color: #fff;
  line-height: 1.5;
}

/* time 时间分隔条 */
.time-divider {
  display: flex;
  justify-content: center;
  margin: 20rpx 0;
}

.time-divider text {
  font-size: 11px;
  color: rgba(255,255,255,0.4);
  background: rgba(255,255,255,0.06);
  padding: 4rpx 20rpx;
  border-radius: 8rpx;
}

/* image 表情包消息 */
.bubble-sticker {
  width: 180rpx;
  height: 180rpx;
  border-radius: 12rpx;
  background: rgba(255,255,255,0.06);
}

/* 红包/转账：还原微信原生配色，橙色实心气泡 */
.bubble-redpacket,
.bubble-transfer {
  max-width: 420rpx;
  min-width: 320rpx;
  padding: 0;
  border-radius: 12rpx;
  background: #f79c46;
  overflow: hidden;
}

.redpacket-top,
.transfer-top {
  display: flex;
  align-items: center;
  padding: 24rpx 20rpx;
}

.redpacket-icon {
  width: 64rpx;
  height: 64rpx;
  font-size: 36px;
  line-height: 64rpx;
  text-align: center;
  flex-shrink: 0;
  margin-right: 16rpx;
}

.redpacket-text {
  font-size: 15px;
  color: #fff;
  font-weight: 500;
}

.redpacket-divider,
.transfer-divider {
  height: 1px;
  background: rgba(255,255,255,0.3);
  margin: 0 20rpx;
}

.redpacket-bottom,
.transfer-bottom {
  display: block;
  font-size: 11px;
  color: rgba(255,255,255,0.85);
  padding: 10rpx 20rpx 16rpx;
}

.transfer-icon {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background: rgba(255,255,255,0.25);
  color: #fff;
  font-size: 32rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  margin-right: 16rpx;
}

.transfer-info {
  display: flex;
  flex-direction: column;
}

.transfer-amount {
  font-size: 17px;
  color: #fff;
  font-weight: 600;
}

.transfer-remark {
  font-size: 12px;
  color: rgba(255,255,255,0.85);
  margin-top: 4rpx;
}
