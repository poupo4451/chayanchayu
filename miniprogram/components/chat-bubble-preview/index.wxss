/**
 * 聊天气泡预览样式
 * =====================================================================
 * 视觉标准对齐微信真实观感，同时尽量保持与 Remotion 渲染端一致。
 *
 * 核心规范：
 *   头像: 80rpx, 圆角: 16rpx
 *   头像间距: 16rpx
 *   气泡最大宽度: 440rpx（更接近微信约 65% 屏宽）
 *   气泡圆角: 10rpx
 *   气泡内边距: 19rpx 24rpx
 *   正文: 34rpx, color #191919, line-height 1.4, max-width 18em
 *   昵称: 24rpx, color #B2B2B2
 *   时间分隔: 24rpx, color #9A9A9A
 *   表情包: 240rpx × 240rpx
 *   红包/转账卡片: 480rpx
 */

/* ── 行容器 ────────────────────────────────────────────── */
/* margin-bottom 仅影响小程序预览列表的疏密，不参与视频输出：
   渲染端每条气泡是独立容器，纵向位置由 paddingTop/marginBottom
   配合逐条入场动画决定（见 ChatMVComposition），与此处无关。 */
.bubble-row {
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
  margin-bottom: 28rpx;
}

.bubble-row-right {
  flex-direction: row-reverse;
}

/* ── 头像 ──────────────────────────────────────────────── */
.avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #FFFFFF;
  font-size: 34rpx;
  font-weight: 500;
  flex-shrink: 0;
  overflow: hidden;
  background: #C6C7CB;
}

.avatar-img {
  width: 100%;
  height: 100%;
  display: block;
}

/* ── 内容列 ────────────────────────────────────────────── */
.content-col {
  display: flex;
  flex-direction: column;
  max-width: 440rpx;
  flex: 0 1 auto;
  min-width: 0;
  align-items: flex-start;
}

.content-col-right {
  align-items: flex-end;
}

/* ── 昵称 ──────────────────────────────────────────────── */
.bubble-name {
  display: block;
  font-size: 24rpx;
  color: #B2B2B2;
  line-height: 1.2;
  padding: 0 4rpx;
  margin-bottom: 6rpx;
  white-space: nowrap;
}

/* ── 气泡容器 ──────────────────────────────────────────── */
.bubble-container {
  position: relative;
  min-width: 44rpx;
}

/* ── 气泡本体 ──────────────────────────────────────────── */
.bubble {
  position: relative;
  min-width: 44rpx;
  padding: 19rpx 24rpx;
  border-radius: 10rpx;
  background: #FFFFFF;
  display: inline-flex;
  flex: 0 1 auto;
}

.bubble-right {
  background: #95EC69;
}

/* ── 正文 ──────────────────────────────────────────────── */
.bubble-text {
  font-size: 34rpx;
  color: #191919;
  line-height: 1.4;
  white-space: pre-wrap;
  word-break: break-word;
  max-width: 18em;
  display: inline-block;
}

/* ── 气泡尖角 ─────────────────────────────────────────── */
.bubble-tail {
  position: absolute;
  top: 30rpx;
  width: 0;
  height: 0;
  border-style: solid;
}

.bubble-tail-left {
  left: -10rpx;
  border-width: 11rpx 12rpx 11rpx 0;
  border-color: transparent #FFFFFF transparent transparent;
}

.bubble-tail-right {
  right: -10rpx;
  border-width: 11rpx 0 11rpx 12rpx;
  border-color: transparent transparent transparent #95EC69;
}

/* ── 时间分隔药丸 ─────────────────────────────────────── */
.time-divider {
  display: flex;
  justify-content: center;
  margin: 20rpx 0;
}

.time-divider text {
  font-size: 24rpx;
  color: #9A9A9A;
  background: rgba(0, 0, 0, 0.06);
  padding: 8rpx 24rpx;
  border-radius: 10rpx;
}

/* ── 图片表情包 ───────────────────────────────────────── */
.bubble-image {
  width: 240rpx;
  height: 240rpx;
  border-radius: 10rpx;
  display: block;
}

.bubble-image-fallback {
  display: flex;
  align-items: center;
  justify-content: center;
  background: #F5F5F5;
  color: #9A9A9A;
  font-size: 28rpx;
}

/* ── 红包/转账 SVG 卡片 ────────────────────────────────── */
.pay-card-img {
  width: 480rpx;
  height: auto;
  display: block;
}
