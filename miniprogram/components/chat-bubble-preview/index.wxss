/**
 * 聊天气泡预览样式
 * =====================================================================
 * 所有尺寸严格对齐 cloud-run-remotion/src/remotion/animation-config.ts 中的
 * WX_SIZES / WX_COLORS 规范，换算关系：1 iOS pt ≈ 2 rpx。
 *
 * 核心规范：
 *   头像: 80rpx (40pt), 圆角: 16rpx (边长 0.2 倍)
 *   头像间距: 20rpx (10pt)
 *   气泡最大宽度: 360rpx (180pt)
 *   气泡圆角: 10rpx (5pt)
 *   气泡内边距: 19rpx 24rpx (9.5pt 12pt)
 *   气泡阴影: 0 4rpx 20rpx rgba(0,0,0,0.06)
 *   正文: 34rpx/17px, color #191919, line-height 1.35, max-width 14em
 *   昵称: 24rpx/12px, color #B2B2B2
 *   时间分隔: 24rpx/12px, color #9A9A9A, 药丸 rgba(0,0,0,0.06)
 *   表情包: 240rpx × 240rpx (120pt), 圆角 10rpx (5pt)
 *   红包/转账卡片: 480rpx (190pt × 1.1)
 */

/* ── 行容器：头像 + 内容列 ──────────────────────────────── */
.bubble-row {
  display: flex;
  align-items: flex-start;
  gap: 20rpx;
  margin-bottom: 30rpx;
}

.bubble-row-right {
  flex-direction: row-reverse;
}

/* ── 头像：统一灰底首字母回退，与 Remotion Avatar 一致 ── */
.avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #FFFFFF;
  font-size: 34rpx;
  font-weight: 500;
  flex-shrink: 0;
  overflow: hidden;
  background: #C6C7CB;
}

.avatar-img {
  width: 100%;
  height: 100%;
  display: block;
}

/* ── 内容列：昵称在气泡外 ──────────────────────────────── */
.content-col {
  display: flex;
  flex-direction: column;
  max-width: 360rpx;
  flex: 0 1 auto;
  min-width: 0;
  align-items: flex-start;
}

.content-col-right {
  align-items: flex-end;
}

/* ── 昵称 ──────────────────────────────────────────────── */
.bubble-name {
  display: block;
  font-size: 24rpx;
  color: #B2B2B2;
  line-height: 1.2;
  padding: 0 4rpx;
  margin-bottom: 8rpx;
  white-space: nowrap;
}

/* ── 气泡容器（尖角定位锚点） ───────────────────────────── */
.bubble-container {
  position: relative;
  min-width: 44rpx;
}

/* ── 气泡本体 ──────────────────────────────────────────── */
.bubble {
  position: relative;
  min-width: 44rpx;
  padding: 19rpx 24rpx;
  border-radius: 10rpx;
  background: #FFFFFF;

  display: inline-flex;
  flex: 0 1 auto;
}

.bubble-right {
  background: #95EC69;
}

/* ── 正文 ──────────────────────────────────────────────── */
.bubble-text {
  font-size: 34rpx;
  color: #191919;
  line-height: 1.35;
  white-space: pre-wrap;
  word-break: break-word;
  max-width: 14em;
  display: inline-block;
}

/* ── 气泡尖角（CSS border 三角形） ─────────────────────── */
.bubble-tail {
  position: absolute;
  top: 30rpx;
  width: 0;
  height: 0;
  border-style: solid;
}

.bubble-tail-left {
  left: -10rpx;
  border-width: 11rpx 12rpx 11rpx 0;
  border-color: transparent #FFFFFF transparent transparent;
}

.bubble-tail-right {
  right: -10rpx;
  border-width: 11rpx 0 11rpx 12rpx;
  border-color: transparent transparent transparent #95EC69;
}

/* ── 时间分隔药丸 ─────────────────────────────────────── */
.time-divider {
  display: flex;
  justify-content: center;
  margin: 20rpx 0;
}

.time-divider text {
  font-size: 24rpx;
  color: #9A9A9A;
  background: rgba(0, 0, 0, 0.06);
  padding: 8rpx 24rpx;
  border-radius: 10rpx;
}

/* ── 图片表情包 ────────────────────────────────────────── */
.bubble-image {
  width: 240rpx;
  height: 240rpx;
  border-radius: 10rpx;
  display: block;
}

.bubble-image-fallback {
  display: flex;
  align-items: center;
  justify-content: center;
  background: #F5F5F5;
  color: #9A9A9A;
  font-size: 28rpx;
}

/* ── 红包/转账 SVG 卡片 ────────────────────────────────── */
.pay-card-img {
  width: 480rpx;
  height: auto;
  display: block;
}
