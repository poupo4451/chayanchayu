page {
  background: #000000;
  height: 100%;
}

.detail-page {
  position: fixed;
  inset: 0;
  width: 100vw;
  height: 100vh;
  background: #000000;
  overflow: hidden;
}

.fullscreen-video {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
}

.back-btn {
  position: fixed;
  left: 24rpx;
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  background: rgba(0, 0, 0, 0.4);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 30;
}

.back-icon {
  color: #ffffff;
  font-size: 40rpx;
  font-weight: 700;
  line-height: 1;
  margin-top: -4rpx;
}

.state-layer {
  position: absolute;
  inset: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 0 60rpx;
}

.loading-spinner {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  border: 5rpx solid rgba(255, 255, 255, 0.2);
  border-top-color: #ffffff;
  animation: detail-spin 0.8s linear infinite;
  margin-bottom: 24rpx;
}

@keyframes detail-spin {
  from { transform: rotate(0deg); }
  to { transform: rotate(360deg); }
}

.state-title {
  color: #ffffff;
  font-size: 17px;
  font-weight: 700;
  margin-bottom: 16rpx;
  text-align: center;
}

.state-text {
  color: rgba(255, 255, 255, 0.65);
  font-size: 14px;
  text-align: center;
  line-height: 1.6;
}

.retry-btn {
  margin-top: 32rpx;
  padding: 18rpx 56rpx;
  border-radius: 999px;
  background: linear-gradient(135deg, #00B865 0%, #009A55 100%);
}

.retry-btn text {
  color: #ffffff;
  font-size: 14px;
  font-weight: 600;
}

.controls-overlay {
  position: absolute;
  inset: 0;
  z-index: 20;
  transition: opacity 0.25s ease;
}

.controls-visible {
  opacity: 1;
}

.controls-hidden {
  opacity: 0;
  pointer-events: none;
}

.top-gradient {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  background: linear-gradient(to bottom, rgba(0, 0, 0, 0.55), rgba(0, 0, 0, 0));
}

.video-title {
  position: fixed;
  left: 120rpx;
  right: 40rpx;
  height: 72rpx;
  line-height: 72rpx;
  color: #ffffff;
  font-size: 16px;
  font-weight: 600;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.center-play {
  position: absolute;
  top: 50%;
  left: 50%;
  width: 108rpx;
  height: 108rpx;
  margin: -54rpx 0 0 -54rpx;
  border-radius: 50%;
  background: rgba(0, 0, 0, 0.4);
  display: flex;
  align-items: center;
  justify-content: center;
}

.play-icon {
  color: #ffffff;
  font-size: 40rpx;
}

.bottom-bar {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  align-items: center;
  padding: 20rpx 30rpx 24rpx;
  background: linear-gradient(to top, rgba(0, 0, 0, 0.6), rgba(0, 0, 0, 0));
}

.play-btn-small {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.16);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  margin-right: 16rpx;
}

.play-btn-small text {
  color: #ffffff;
  font-size: 13px;
}

.time-text {
  color: rgba(255, 255, 255, 0.85);
  font-size: 11px;
  flex-shrink: 0;
  min-width: 72rpx;
  text-align: center;
}

.progress-slider {
  flex: 1;
  margin: 0 8rpx;
}

.save-btn {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.16);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  margin-left: 16rpx;
}

.download-arrow {
  width: 0;
  height: 0;
  border-left: 12rpx solid transparent;
  border-right: 12rpx solid transparent;
  border-top: 18rpx solid #ffffff;
  margin-top: 4rpx;
}
