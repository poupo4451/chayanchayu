<view class="page works-page" style="padding-top: {{safeTop}}px;">
  <text class="page-title">我的作品</text>

  <!-- 用户信息区 -->
  <view class="profile-card">
    <view class="avatar-wrapper">
      <image class="profile-avatar" src="{{userProfile.avatarUrl || '/images/default-avatar.png'}}" mode="aspectFill" />
      <button class="avatar-btn-overlay" open-type="chooseAvatar" bindchooseavatar="onChooseAvatar" plain="true" />
    </view>
    <view class="profile-info">
      <view class="profile-nickname-row">
        <input
          class="profile-nickname"
          type="nickname"
          placeholder="轻触填入微信昵称"
          value="{{userProfile.nickName}}"
          focus="{{nicknameFocus}}"
          bindfocus="onNicknameFocus"
          bindblur="onNicknameBlur"
        />
      </view>
      <text class="profile-count">共 {{works.length}} 个作品</text>
    </view>
  </view>

  <block wx:if="{{loading}}">
    <text class="text-sub">加载中…</text>
  </block>
  <block wx:elif="{{works.length === 0}}">
    <view class="empty-state">
      <text class="text-sub">还没有作品，快去创作一个吧～</text>
    </view>
  </block>
  <block wx:else>
    <view class="swipe-item" wx:for="{{works}}" wx:key="id">
      <!-- 删除按钮（卡片后方，左滑后可见） -->
      <view
        class="swipe-delete"
        style="opacity: {{item.swipeX < -20 ? 1 : 0}};"
        catchtap="onDeleteConfirm"
        data-index="{{index}}"
      >
        <text class="swipe-delete-icon">✕</text>
      </view>
      <!-- 整张卡片（可滑动） -->
      <view
        class="swipe-card-wrap"
        style="transform: translateX({{item.swipeX}}px); transition: {{touching ? 'none' : 'transform 0.25s ease'}};"
        data-index="{{index}}"
        bindtouchstart="onSwipeStart"
        bindtouchmove="onSwipeMove"
        bindtouchend="onSwipeEnd"
        catchtap="onOpenWork"
      >
        <view class="work-card card {{item.type === 'task' ? 'work-card-pending' : ''}}">
          <view class="work-cover">
            <image
              wx:if="{{item.type !== 'task'}}"
              class="work-cover-img"
              src="/images/work-cover-icon.svg"
              mode="aspectFill"
            />
            <view wx:if="{{item.type === 'task'}}" class="work-cover-spinner"></view>
          </view>
          <view class="work-info">
            <view class="work-header">
              <text class="work-title">{{item.title}}</text>
              <text wx:if="{{item.type !== 'task'}}" class="work-duration">{{item.durationText}}</text>
              <view wx:if="{{item.type === 'task'}}" class="work-status-row">
                <text class="work-status-badge work-status-badge-{{item.status}}">{{item.statusLabel}}</text>
                <text class="work-status-progress">{{item.progress}}%</text>
              </view>
            </view>
            <text class="work-time">{{item.createdAtText}}</text>
          </view>
        </view>
      </view>
    </view>
  </block>
</view>
