.works-page {
  /* 顶部安全距离由 JS 动态计算后通过 inline style 设置，这里仅保留兜底值 */
  padding-top: 80rpx;
  /* 底部需叠加自定义 tab-bar 高度(110rpx) + 系统底部安全区，避免最后一条被 tab-bar 遮住 */
  padding-bottom: calc(110rpx + env(safe-area-inset-bottom) + 40rpx);
}

.empty-state {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  padding-top: 200rpx;
}

/* ===== 用户信息区 ===== */

.profile-card {
  display: flex;
  flex-direction: row;
  align-items: center;
  padding: 28rpx 30rpx;
  margin-bottom: 30rpx;
}

.avatar-btn {
  width: 120rpx;
  height: 120rpx;
  padding: 0;
  margin: 0;
  border-radius: 50%;
  background: transparent;
  border: none;
  flex-shrink: 0;
  line-height: 1;
}

.avatar-btn::after {
  border: none;
}

.profile-avatar {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  overflow: hidden;
  display: block;
}

.profile-avatar-empty {
  background: linear-gradient(135deg, #e8f5e9, #c8e6c9);
  display: flex;
  align-items: center;
  justify-content: center;
}

.profile-avatar-text {
  font-size: 48rpx;
  line-height: 1;
}

.profile-info {
  display: flex;
  flex-direction: column;
  margin-left: 24rpx;
  flex: 1;
  min-width: 0;
}

.profile-nickname {
  font-size: 17px;
  font-weight: 600;
  color: var(--text-main);
  height: 48rpx;
  line-height: 48rpx;
  padding: 0;
  margin-bottom: 8rpx;
  background: transparent;
}

.profile-count {
  font-size: 13px;
  color: var(--text-sub);
}

/* ===== 作品卡片 ===== */

.work-card {
  display: flex;
  flex-direction: row;
  align-items: center;
}

.work-card-pending {
  opacity: 0.88;
}

/* 左滑删除 */
.swipe-item {
  position: relative;
  overflow: hidden;
  margin-bottom: 20rpx;
}

.swipe-delete {
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  width: 140rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #FF4D4F;
  border-radius: 24rpx;
  opacity: 0;
  transition: opacity 0.25s ease;
}

.swipe-delete-icon {
  font-size: 40rpx;
  color: #fff;
}

.swipe-content {
  position: relative;
  z-index: 1;
  background: var(--bg-card, #FFFFFF);
}

.work-cover {
  width: 160rpx;
  height: 100rpx;
  border-radius: 16rpx;
  background: linear-gradient(135deg, #00B865 0%, #009A55 100%);
  margin-right: 20rpx;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
}

.work-cover-spinner {
  width: 36rpx;
  height: 36rpx;
  border-radius: 50%;
  border: 4rpx solid rgba(255, 255, 255, 0.35);
  border-top-color: #ffffff;
  animation: work-spin 0.8s linear infinite;
}

@keyframes work-spin {
  from { transform: rotate(0deg); }
  to { transform: rotate(360deg); }
}

.work-info {
  display: flex;
  flex-direction: column;
  flex: 1;
  min-width: 0;
}

.work-title {
  font-size: 15px;
  font-weight: 600;
  margin-bottom: 8rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.work-duration {
  font-size: 12px;
  color: var(--text-sub);
}

.work-time {
  font-size: 12px;
  color: var(--text-hint);
}

.work-meta-row {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 16rpx;
}

.work-status-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.work-status-badge {
  font-size: 11px;
  padding: 4rpx 14rpx;
  border-radius: 999px;
  background: rgba(0, 184, 101, 0.12);
  color: #00B865;
}

.work-status-badge-failed {
  background: rgba(255, 87, 87, 0.18);
  color: #FF6B6B;
}

.work-status-progress {
  font-size: 11px;
  color: var(--text-sub);
}
