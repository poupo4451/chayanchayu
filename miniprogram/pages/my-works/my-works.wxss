.works-page {
  /* 顶部安全距离由 JS 动态计算后通过 inline style 设置，这里仅保留兜底值 */
  padding-top: 80rpx;
  /* 底部需叠加自定义 tab-bar 高度(110rpx) + 系统底部安全区，避免最后一条被 tab-bar 遮住 */
  padding-bottom: calc(110rpx + env(safe-area-inset-bottom) + 40rpx);
}

.empty-state {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  padding-top: 200rpx;
}

/* ===== 用户信息区 ===== */

.profile-card {
  display: flex;
  flex-direction: row;
  align-items: center;
  padding: 28rpx 30rpx;
  margin-bottom: 30rpx;
  background: rgba(0, 0, 0, 0.05);
  border-radius: 24rpx;
}

/* 圆形头像容器 */
.avatar-wrapper {
  position: relative;
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  overflow: hidden;
  flex-shrink: 0;
}

.profile-avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  display: block;
}

/* 透明按钮覆盖层，用于触发 chooseAvatar */
.avatar-btn-overlay {
  position: absolute;
  top: 0;
  left: 0;
  width: 80rpx;
  height: 80rpx;
  padding: 0;
  margin: 0;
  border-radius: 50%;
  background: transparent;
  opacity: 0;
  border: none;
}

.avatar-btn-overlay::after {
  content: none;
  border: none;
}

.profile-avatar-empty {
  background: linear-gradient(135deg, #e8f5e9, #c8e6c9);
  display: flex;
  align-items: center;
  justify-content: center;
}

.profile-avatar-text {
  font-size: 48rpx;
  line-height: 1;
}

.profile-info {
  display: flex;
  flex-direction: column;
  margin-left: 24rpx;
  flex: 1;
  min-width: 0;
}

.profile-nickname-row {
  display: flex;
  flex-direction: column;
}

.profile-nickname {
  font-size: 15px;
  font-weight: 600;
  color: var(--text-main);
  height: 48rpx;
  line-height: 48rpx;
  padding: 0;
  margin-bottom: 0;
  background: transparent;
}

.profile-count {
  font-size: 13px;
  color: var(--text-sub);
  font-weight: 500;
}

/* ===== 作品卡片 ===== */

.work-card {
  display: flex;
  flex-direction: row;
  align-items: center;
  margin-bottom: 0;
}

.work-card-pending {
  opacity: 0.88;
}

/* 左滑删除 */
.swipe-item {
  position: relative;
  margin-bottom: 20rpx;
  display: flex;
  align-items: center;
}

.swipe-delete {
  position: absolute;
  right: 48rpx;
  top: 0;
  bottom: 0;
  margin: auto 0;
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background: #FF4D4F;
  display: flex;
  align-items: center;
  justify-content: center;
  opacity: 0;
  transition: opacity 0.2s ease;
  z-index: 0;
}

.swipe-delete-icon {
  font-size: 28rpx;
  color: #fff;
  font-weight: 700;
  line-height: 1;
}

.swipe-card-wrap {
  position: relative;
  z-index: 1;
  width: 100%;
}

.work-cover {
  width: 120rpx;
  height: 120rpx;
  border-radius: 12rpx;
  background: #00B865;
  margin-right: 20rpx;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
}

.work-cover-img {
  width: 120rpx;
  height: 120rpx;
}

.work-cover-spinner {
  width: 28rpx;
  height: 28rpx;
  border-radius: 50%;
  border: 3rpx solid rgba(255, 255, 255, 0.35);
  border-top-color: #ffffff;
  animation: work-spin 0.8s linear infinite;
}

@keyframes work-spin {
  from { transform: rotate(0deg); }
  to { transform: rotate(360deg); }
}

.work-info {
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  flex: 1;
  min-width: 0;
  height: 120rpx;
}

.work-header {
  display: flex;
  flex-direction: column;
}

.work-title {
  font-size: 15px;
  font-weight: 600;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.work-duration {
  font-size: 12px;
  color: var(--text-hint);
}

.work-time {
  font-size: 12px;
  color: var(--text-hint);
}

.work-status-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.work-status-badge {
  font-size: 11px;
  padding: 4rpx 14rpx;
  border-radius: 999px;
  background: rgba(0, 184, 101, 0.12);
  color: #00B865;
}

.work-status-badge-failed {
  background: rgba(255, 87, 87, 0.18);
  color: #FF6B6B;
}

.work-status-progress {
  font-size: 11px;
  color: var(--text-sub);
}
