/**
 * 生成进度页
 * =====================================================================
 * 设计令牌与 create / dialogue-preview 对齐：
 *   横向水槽 32rpx｜面板圆角 28rpx｜控件圆角 20rpx｜主按钮高 96rpx
 * 视觉策略：灰底沉浸 + 超大细体读数为唯一重心，绿色仅用于「当前活跃」。
 */

.tp-page {
  min-height: 100vh;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  background: #EDEDED;
}

/* ==================== 状态读数 ====================
   裸露在灰底上，不套白卡片，保证大数字的呼吸感 */
.hero {
  padding: 72rpx 32rpx 0;
  display: flex;
  flex-direction: column;
}

/* AIGC 内容标识：11 字长句，字距收到 1rpx（原 4rpx 是为 4 字短标签设计的） */
.hero-eyebrow {
  font-size: 22rpx;
  letter-spacing: 1rpx;
  color: rgba(0, 0, 0, 0.6);
}

.metric {
  display: flex;
  flex-direction: row;
  align-items: flex-end;
  margin-top: 18rpx;
}

/* 细体超大字是本页唯一的视觉重心；tabular-nums 防止数字跳动时宽度抖动 */
.metric-num {
  font-size: 112rpx;
  font-weight: 300;
  line-height: 1;
  letter-spacing: -2rpx;
  color: #1A1A1A;
  font-variant-numeric: tabular-nums;
}

.metric-unit {
  margin-left: 10rpx;
  margin-bottom: 12rpx;
  font-size: 28rpx;
  color: #A8A8A8;
}

.hero-stage {
  margin-top: 20rpx;
  font-size: 30rpx;
  font-weight: 500;
  line-height: 1.4;
  color: #1A1A1A;
}

/* 6rpx 极细轨道：进度是「读数」的附属刻度，不该抢戏 */
.track {
  margin-top: 34rpx;
  height: 6rpx;
  border-radius: 999rpx;
  background: rgba(0, 0, 0, 0.07);
  overflow: hidden;
}

.track-fill {
  position: relative;
  height: 100%;
  border-radius: 999rpx;
  background: #00B865;
  overflow: hidden;
  transition: width 0.6s cubic-bezier(0.22, 0.61, 0.36, 1);
}

.track-fill-fail {
  background: #E74C3C;
}

/* 流光：长阶段里进度数值几乎不动，靠它传达「仍在运行」 */
.track-shine {
  position: absolute;
  top: 0;
  bottom: 0;
  width: 120rpx;
  background: linear-gradient(90deg,
    rgba(255, 255, 255, 0) 0%,
    rgba(255, 255, 255, 0.75) 50%,
    rgba(255, 255, 255, 0) 100%);
  animation: tp-shine 1.8s ease-in-out infinite;
}

@keyframes tp-shine {
  0%   { transform: translateX(-100%); }
  100% { transform: translateX(600%); }
}

/* ==================== 流程清单 ==================== */
.steps {
  margin: 56rpx 32rpx 0;
  padding: 6rpx 28rpx 6rpx 24rpx;
  border-radius: 28rpx;
  background: #FFFFFF;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.03);
}

.step {
  display: flex;
  flex-direction: row;
}

.step-rail {
  width: 32rpx;
  flex-shrink: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.step-dot {
  position: relative;
  width: 32rpx;
  height: 32rpx;
  margin-top: 26rpx;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
}

/* flex:1 让连接线自动填满两点之间，无需按内容高度写死 */
.step-line {
  flex: 1;
  width: 2rpx;
  margin: 8rpx 0;
  background: rgba(0, 0, 0, 0.07);
}

.step-check {
  width: 32rpx;
  height: 32rpx;
  border-radius: 50%;
  background: rgba(0, 184, 101, 0.14);
  color: #00964F;
  font-size: 20rpx;
  line-height: 32rpx;
  text-align: center;
}

.step-cross {
  width: 32rpx;
  height: 32rpx;
  border-radius: 50%;
  background: rgba(231, 76, 60, 0.12);
  color: #E74C3C;
  font-size: 20rpx;
  line-height: 32rpx;
  text-align: center;
}

.step-live {
  position: relative;
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  background: #00B865;
}

.step-pulse {
  position: absolute;
  left: -8rpx;
  top: -8rpx;
  width: 32rpx;
  height: 32rpx;
  border-radius: 50%;
  background: rgba(0, 184, 101, 0.28);
  animation: tp-pulse 1.8s ease-out infinite;
}

@keyframes tp-pulse {
  0%   { transform: scale(0.5); opacity: 0.85; }
  100% { transform: scale(1.7); opacity: 0; }
}

.step-idle {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: rgba(0, 0, 0, 0.14);
}

.step-body {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 6rpx;
  padding: 22rpx 0 22rpx 20rpx;
}

/* 靠颜色与字重区分三态，不额外加标签，保持清单干净 */
.step-label {
  font-size: 27rpx;
  color: #B5B5B5;
}

.step-done .step-label { color: #5A5A5A; }
.step-active .step-label { color: #1A1A1A; font-weight: 600; }
.step-fail .step-label { color: #C0392B; font-weight: 600; }

.step-note {
  font-size: 21rpx;
  line-height: 1.5;
  color: #A8A8A8;
}

/* ==================== 完成通知开关 ====================
   与 .steps 同为白卡片，但未开启时用绿色描边把它从"信息"提升为"可操作"，
   开启后描边收掉、退回普通信息条，不再争夺注意力。 */
.notify {
  display: flex;
  flex-direction: row;
  align-items: center;
  margin: 24rpx 32rpx 0;
  padding: 24rpx 24rpx;
  border-radius: 28rpx;
  background: #FFFFFF;
  border: 2rpx solid rgba(0, 184, 101, 0.28);
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.03);
}

.notify-on {
  border-color: transparent;
  background: rgba(0, 184, 101, 0.07);
  box-shadow: none;
}

.notify-hover {
  background: #F6F6F6;
}

.notify-icon {
  width: 56rpx;
  height: 56rpx;
  flex-shrink: 0;
  border-radius: 50%;
  background: rgba(0, 184, 101, 0.12);
  display: flex;
  align-items: center;
  justify-content: center;
}

/* 纯 CSS 铃铛，与 dialogue-preview 邀请弹层同一画法，保持视觉一致 */
.notify-bell {
  width: 22rpx;
  height: 22rpx;
  border: 3rpx solid #00B865;
  border-bottom-width: 5rpx;
  border-radius: 50% 50% 6rpx 6rpx;
}

/* 旋转 45° 的两条边构成对勾 */
.notify-tick {
  width: 20rpx;
  height: 11rpx;
  border-left: 4rpx solid #00964F;
  border-bottom: 4rpx solid #00964F;
  transform: rotate(-45deg) translateY(-3rpx);
}

.notify-body {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 6rpx;
  padding-left: 20rpx;
}

.notify-title {
  font-size: 27rpx;
  font-weight: 600;
  color: #1A1A1A;
}

.notify-desc {
  font-size: 21rpx;
  line-height: 1.5;
  color: #A8A8A8;
}

.notify-arrow {
  flex-shrink: 0;
  padding-left: 12rpx;
  font-size: 34rpx;
  line-height: 1;
  color: #C8C8C8;
}

/* ==================== 失败说明 ==================== */
.alert {
  margin: 24rpx 32rpx 0;
  padding: 22rpx 24rpx;
  border-radius: 20rpx;
  background: rgba(231, 76, 60, 0.08);
}

.alert-text {
  font-size: 24rpx;
  line-height: 1.5;
  color: #C0392B;
}

/* ==================== 底部操作 ====================
   状态页不是操作页，故不用白色 sheet，避免抢走大数字的重心 */
.tp-footer-space {
  flex: 1;
  min-height: 60rpx;
}

.footer {
  padding: 0 32rpx 24rpx;
  padding-bottom: calc(24rpx + env(safe-area-inset-bottom));
}

.footer-row {
  display: flex;
  flex-direction: row;
  gap: 20rpx;
}

.btn-ghost {
  flex-shrink: 0;
  height: 96rpx;
  padding: 0 40rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 20rpx;
  background: rgba(0, 0, 0, 0.05);
  color: #4A4A4A;
  font-size: 26rpx;
}

.btn-ghost-block {
  padding: 0;
  color: #7A7A7A;
  background: rgba(0, 0, 0, 0.035);
}

.btn-ghost-hover {
  background: rgba(0, 0, 0, 0.1);
}

.btn-primary {
  flex: 1;
  height: 96rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 20rpx;
  background: linear-gradient(180deg, #00C06B 0%, #00B865 100%);
  color: #FFFFFF;
  font-size: 29rpx;
  font-weight: 600;
  letter-spacing: 1rpx;
  box-shadow: 0 6rpx 18rpx rgba(0, 184, 101, 0.24);
}

.btn-primary-hover {
  background: linear-gradient(180deg, #00B865 0%, #009A55 100%);
  box-shadow: 0 2rpx 8rpx rgba(0, 184, 101, 0.28);
}

/* ==================== 订阅通知邀请弹层 ====================
   自定义弹层而非 wx.showModal —— 原因见 WXML 注释（需保住 tap 手势）。
   视觉沿用本页令牌：面板圆角 28rpx｜主按钮高 96rpx */
.nm-mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  z-index: 200;
  background: rgba(0, 0, 0, 0.45);
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0 56rpx;
  animation: nm-fade 0.18s ease-out;
}

@keyframes nm-fade {
  from { opacity: 0; }
  to   { opacity: 1; }
}

.nm-card {
  width: 100%;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 56rpx 40rpx 32rpx;
  border-radius: 28rpx;
  background: #FFFFFF;
  animation: nm-rise 0.22s cubic-bezier(0.22, 0.61, 0.36, 1);
}

@keyframes nm-rise {
  from { transform: translateY(28rpx) scale(0.97); opacity: 0; }
  to   { transform: translateY(0) scale(1); opacity: 1; }
}

/* 铃铛用纯 CSS 画：省一张图，且能跟主色保持严格一致 */
.nm-bell {
  position: relative;
  width: 88rpx;
  height: 88rpx;
  border-radius: 50%;
  background: rgba(0, 184, 101, 0.1);
  display: flex;
  align-items: center;
  justify-content: center;
}

.nm-bell::after {
  content: '';
  width: 30rpx;
  height: 30rpx;
  border-radius: 50% 50% 8rpx 8rpx;
  border: 4rpx solid #00B865;
  border-bottom-width: 6rpx;
}

/* 右上角未读点：暗示「会有一条消息到达」 */
.nm-bell-dot {
  position: absolute;
  top: 20rpx;
  right: 22rpx;
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  background: #FF4D4F;
  border: 3rpx solid #FFFFFF;
}

.nm-title {
  margin-top: 28rpx;
  font-size: 32rpx;
  font-weight: 600;
  line-height: 1.4;
  color: #1A1A1A;
  text-align: center;
}

.nm-desc {
  margin-top: 14rpx;
  font-size: 25rpx;
  line-height: 1.6;
  color: #8A8A8A;
  text-align: center;
}

.nm-primary {
  width: 100%;
  height: 96rpx;
  margin-top: 40rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 20rpx;
  background: linear-gradient(180deg, #00C06B 0%, #00B865 100%);
  color: #FFFFFF;
  font-size: 29rpx;
  font-weight: 600;
  letter-spacing: 1rpx;
  box-shadow: 0 6rpx 18rpx rgba(0, 184, 101, 0.24);
}

.nm-primary-hover {
  background: linear-gradient(180deg, #00B865 0%, #009A55 100%);
  box-shadow: 0 2rpx 8rpx rgba(0, 184, 101, 0.28);
}

/* 拒绝项做成无背景文字键：不给「跳过」任何视觉重量，但也不藏起来 */
.nm-ghost {
  width: 100%;
  height: 80rpx;
  margin-top: 8rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 20rpx;
  color: #9A9A9A;
  font-size: 26rpx;
}

.nm-ghost-hover {
  background: rgba(0, 0, 0, 0.04);
}
