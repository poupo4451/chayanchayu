<view class="create-page">
  <scroll-view class="create-scroll" scroll-y enhanced show-scrollbar="{{false}}">
    <!-- ==================== 主题输入 ==================== -->
    <view class="input-card">
      <textarea
        class="topic-input"
        placeholder="想聊点什么？一句话说清场景，越具体越好"
        placeholder-class="topic-placeholder"
        value="{{topic}}"
        bindinput="onTopicInput"
        maxlength="{{maxLen}}"
        cursor-spacing="32"
        adjust-position
        show-confirm-bar="{{false}}"
      />
      <view class="input-footer">
        <text class="counter {{topic.length > 80 ? 'counter-warn' : ''}}">{{topic.length}}/{{maxLen}}</text>
      </view>
    </view>

    <!-- ==================== 灵感胶囊 ==================== -->
    <view class="inspire">
      <view class="inspire-head">
        <text class="inspire-title">没想法？点一个试试</text>
      </view>
      <view class="inspire-wrap">
        <view
          class="inspire-chip"
          wx:for="{{inspirations}}"
          wx:key="*this"
          data-value="{{item}}"
          hover-class="inspire-chip-hover"
          hover-stay-time="60"
          bindtap="onPickInspiration"
        >
          <text class="inspire-chip-text">{{item}}</text>
        </view>
      </view>
    </view>

    <!-- ==================== 对话风格 ==================== -->
    <view class="section">
      <view class="section-head">
        <text class="section-title">对话风格</text>
        <text class="section-note">决定聊天的味道</text>
      </view>
      <view class="tone-grid">
        <view
          class="tone-item {{selectedTone === item.name ? 'tone-item-on' : ''}}"
          wx:for="{{dialogueTones}}"
          wx:key="name"
          data-value="{{item.name}}"
          hover-class="tone-item-hover"
          hover-stay-time="60"
          bindtap="selectTone"
        >
          <text class="tone-name">{{item.name}}</text>
          <text class="tone-desc">{{item.desc}}</text>
        </view>
      </view>
    </view>

    <!-- ==================== 音乐风格 ==================== -->
    <view class="section">
      <view class="section-head">
        <text class="section-title">音乐风格</text>
        <text class="section-note">决定成品的听感</text>
      </view>
      <view class="genre-wrap">
        <view
          class="genre-chip {{selectedGenre === item ? 'genre-chip-on' : ''}}"
          wx:for="{{musicGenres}}"
          wx:key="*this"
          data-value="{{item}}"
          hover-class="genre-chip-hover"
          hover-stay-time="60"
          bindtap="selectGenre"
        >
          <text>{{item}}</text>
        </view>
      </view>
    </view>

    <view class="scroll-footer"></view>
  </scroll-view>

  <!-- ==================== 底部提交 ==================== -->
  <view class="sheet">
    <view
      class="btn-primary {{canSubmit ? '' : 'btn-primary-off'}}"
      hover-class="{{canSubmit ? 'btn-primary-hover' : ''}}"
      hover-stay-time="60"
      bindtap="onSubmit"
    >
      <text>{{submitting ? '创建中…' : '开始创作对话'}}</text>
    </view>
  </view>
</view>
