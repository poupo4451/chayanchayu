.hero {
  margin-top: 20rpx;
  margin-bottom: 40rpx;
  background: linear-gradient(135deg, rgba(255,45,120,0.25) 0%, rgba(124,58,237,0.25) 100%);
}

.section-title {
  font-size: 16px;
  font-weight: 600;
  margin-bottom: 20rpx;
}

.case-scroll {
  width: 100%;
  white-space: nowrap;
}

.case-card {
  display: inline-block;
  width: 320rpx;
  margin-right: 20rpx;
  vertical-align: top;
}

.case-cover {
  width: 320rpx;
  height: 200rpx;
  border-radius: 20rpx;
  background: linear-gradient(135deg, #FF2D78 0%, #7C3AED 100%);
  margin-bottom: 12rpx;
}

.case-title {
  display: block;
  font-size: 14px;
  color: #fff;
  margin-bottom: 6rpx;
}

.case-duration {
  display: block;
  font-size: 12px;
  color: var(--text-sub);
}

.fab-create {
  position: fixed;
  right: 40rpx;
  /* 底部悬浮按钮需叠加自定义 tab-bar 高度(110rpx) + 系统底部安全区，否则灵动岛/无 Home 键机型会被 tab-bar 压住 */
  bottom: calc(110rpx + env(safe-area-inset-bottom) + 30rpx);
  height: 88rpx;
  padding: 0 40rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 44rpx;
  background: linear-gradient(135deg, #FF2D78 0%, #FFB800 100%);
  color: #fff;
  font-size: 16px;
  font-weight: 600;
  box-shadow: 0 8rpx 24rpx rgba(255, 45, 120, 0.4);
}
