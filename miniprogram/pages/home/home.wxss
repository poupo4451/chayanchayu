/* 首页：统一沿用全局灰底 #EDEDED，靠卡片白/绿分层 */
.home-page {
  /* 底部需叠加自定义 tab-bar 高度(110rpx) + 系统底部安全区，避免内容被 tab-bar 遮住 */
  padding-bottom: calc(110rpx + env(safe-area-inset-bottom) + 40rpx);
}

/* ===== 标题区 ===== */
.hero {
  display: flex;
  flex-direction: column;
  margin-bottom: 56rpx;
}

.hero-title {
  font-size: 25px;
  font-weight: 700;
  line-height: 1.2;
  letter-spacing: 2rpx;
  color: var(--text-main);
  margin-bottom: 14rpx;
}

.hero-sub {
  font-size: 13px;
  line-height: 1.4;
  letter-spacing: 1rpx;
  color: var(--text-sub);
}

/* ===== 16:9 视频预览 =====
   卡片宽度恒为 670rpx（750 - .page 左右 padding 40rpx*2），
   故高度写死 377rpx 严格保证 16:9，规避低版本 WebView 对 aspect-ratio 的兼容问题 */
.demo-card {
  position: relative;
  width: 100%;
  height: 377rpx;
  border-radius: 24rpx;
  overflow: hidden;
  background: #0D0D0D;
  box-shadow: 0 6rpx 24rpx rgba(0, 0, 0, 0.08);
  margin-bottom: 28rpx;
}

.demo-video {
  width: 100%;
  height: 100%;
  display: block;
}

/* 视频兜底占位 */
.demo-fallback {
  position: absolute;
  inset: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  background: #E4E4E4;
}

.demo-fallback-title {
  font-size: 15px;
  font-weight: 600;
  color: var(--text-sub);
  margin-bottom: 8rpx;
}

.demo-fallback-text {
  font-size: 12px;
  color: var(--text-hint);
}

/* 左上角「案例」角标：纯展示，不拦截点击 */
.demo-tag {
  position: absolute;
  left: 20rpx;
  top: 20rpx;
  padding: 6rpx 18rpx;
  border-radius: 999rpx;
  background: rgba(0, 0, 0, 0.32);
  pointer-events: none;
  z-index: 5;
}

.demo-tag-text {
  font-size: 11px;
  letter-spacing: 2rpx;
  color: rgba(255, 255, 255, 0.92);
}

/* 右下角声音状态提示：纯展示，关闭命中测试让点击落到整张卡片 */
.demo-sound {
  position: absolute;
  right: 20rpx;
  bottom: 20rpx;
  height: 52rpx;
  padding: 0 20rpx;
  display: flex;
  flex-direction: row;
  align-items: center;
  border-radius: 999rpx;
  background: rgba(0, 0, 0, 0.36);
  pointer-events: none;
  z-index: 5;
}

.demo-sound-icon {
  display: flex;
  flex-direction: row;
  align-items: center;
  height: 24rpx;
  margin-right: 12rpx;
}

.demo-wave {
  width: 4rpx;
  height: 8rpx;
  margin-right: 4rpx;
  border-radius: 2rpx;
  background: #FFFFFF;
}

.demo-wave-3 {
  margin-right: 0;
}

/* 有声播放时波形跳动，静音时静止（省电且语义清晰） */
.demo-wave-on.demo-wave-1 {
  animation: wave-beat 0.9s ease-in-out infinite;
}

.demo-wave-on.demo-wave-2 {
  animation: wave-beat 0.9s ease-in-out infinite 0.15s;
}

.demo-wave-on.demo-wave-3 {
  animation: wave-beat 0.9s ease-in-out infinite 0.3s;
}

@keyframes wave-beat {
  0%, 100% { height: 8rpx; }
  50% { height: 22rpx; }
}

.demo-sound-text {
  font-size: 11px;
  letter-spacing: 1rpx;
  color: rgba(255, 255, 255, 0.92);
}

/* ===== 创作作品大卡片 ===== */
.create-card {
  position: relative;
  height: 320rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  border-radius: 24rpx;
  overflow: hidden;
  background: linear-gradient(145deg, #00C46E 0%, #00B865 55%, #009A55 100%);
  box-shadow: 0 10rpx 30rpx rgba(0, 184, 101, 0.26);
}

.create-card-hover {
  background: linear-gradient(145deg, #00B865 0%, #009A55 55%, #008247 100%);
  box-shadow: 0 4rpx 14rpx rgba(0, 184, 101, 0.3);
}

/* 右上角柔光，避免大面积纯色显得扁平 */
.create-glow {
  position: absolute;
  right: -80rpx;
  top: -110rpx;
  width: 320rpx;
  height: 320rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.14);
}

.create-icon {
  width: 80rpx;
  height: 80rpx;
  margin-bottom: 20rpx;
  z-index: 1;
}

.create-title {
  font-size: 17px;
  font-weight: 600;
  letter-spacing: 2rpx;
  color: #FFFFFF;
  margin-bottom: 10rpx;
  white-space: nowrap;
  z-index: 1;
}

.create-sub {
  font-size: 12px;
  letter-spacing: 1rpx;
  color: rgba(255, 255, 255, 0.78);
  white-space: nowrap;
  z-index: 1;
}

/* 右上角额度角标：与案例卡片的「案例」角标保持一致的位置与体量。
   关闭命中测试，让点击落到整张卡片上（卡片本身是创作入口）。 */
.create-quota {
  position: absolute;
  right: 20rpx;
  top: 20rpx;
  padding: 6rpx 18rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.22);
  pointer-events: none;
  z-index: 5;
}

.create-quota-text {
  font-size: 11px;
  letter-spacing: 1rpx;
  color: rgba(255, 255, 255, 0.95);
  white-space: nowrap;
}

/* 次数用尽：换成暖色警示底，让用户点进去之前就知道今天没额度了 */
.create-quota-off {
  background: rgba(255, 214, 102, 0.3);
}

.create-quota-off .create-quota-text {
  color: #FFE9A8;
}

/* ===== 「开发中」占位卡片 =====
   纯展示，不响应任何触摸；3% 黑底 + 40% 黑字 */
.soon-card {
  margin-top: 24rpx;
  height: 132rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 24rpx;
  background: rgba(0, 0, 0, 0.03);
  /* 双重保险：无 bindtap 已不可点，再关闭命中测试，彻底屏蔽点击态与长按 */
  pointer-events: none;
}

.soon-text {
  font-size: 13px;
  letter-spacing: 1rpx;
  color: rgba(0, 0, 0, 0.4);
}
