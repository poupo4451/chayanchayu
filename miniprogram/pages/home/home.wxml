<view class="page" style="padding-top: {{safeTop}}px;">
  <view class="hero card">
    <text class="page-title">言语生声</text>
    <text class="page-desc">输入一个主题，AI帮你编一段"很绿茶"的聊天，再变成一首歌</text>
  </view>

  <view class="section-title">🔥 热门案例</view>
  <scroll-view scroll-x class="case-scroll">
    <view class="case-card" wx:for="{{cases}}" wx:key="id">
      <view class="case-cover"></view>
      <text class="case-title">{{item.title}}</text>
      <text class="case-duration">{{item.duration}}</text>
    </view>
  </scroll-view>

  <view class="fab-create" bindtap="goCreate">
    <text>+ 开始创作</text>
  </view>
</view>
