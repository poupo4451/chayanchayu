.preview-page {
  padding-bottom: 180rpx;
  background: #EDEDED;
}

.bubble-list {
  flex: 1;
}

.action-row {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  padding: 20rpx 40rpx 40rpx;
  background: #FFFFFF;
  box-sizing: border-box;
  border-top: 1px solid var(--border);
  box-shadow: 0 -4rpx 16rpx rgba(0, 0, 0, 0.04);
}

.btn-outline {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 88rpx;
  padding: 0 30rpx;
  border-radius: 44rpx;
  border: 1px solid var(--primary);
  color: var(--primary);
  font-size: 14px;
  margin-right: 20rpx;
  background: transparent;
}

.flex-1 {
  flex: 1;
}
