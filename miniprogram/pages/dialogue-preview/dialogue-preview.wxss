.preview-page {
  padding-bottom: 180rpx;
}

.bubble-list {
  flex: 1;
}

.action-row {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  padding: 20rpx 40rpx 40rpx;
  background: var(--bg-deep);
  box-sizing: border-box;
}

.btn-outline {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 88rpx;
  padding: 0 30rpx;
  border-radius: 44rpx;
  border: 1px solid rgba(255,255,255,0.2);
  color: #fff;
  font-size: 14px;
  margin-right: 20rpx;
}

.flex-1 {
  flex: 1;
}
